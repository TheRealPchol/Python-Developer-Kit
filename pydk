#!/usr/bin/bash

shopt -s expand_aliases

start_git_prj(){
    local dir="$1"
    if [[ -z "$dir" ]]; then
        python3 -m venv ./env
        git init
    else
        python3 -m venv "$dir/env"
        echo "env/" >> "$dir/.gitignore"
        (cd "$dir" && git init)
    fi
}

start_prj(){
    local dir="$1"
    if [[ -z "$dir" ]]; then
        python3 -m venv ./env
    else
        python3 -m venv "$dir/env"
        echo "env/" >> "$dir/.gitignore"
    fi
}

rem_prj(){
    local dir_for_rm="$1"
    if [[ -z "$dir_for_rm" ]]; then
        deactivate &> /dev/null || rm -rf ./env/
        rm -f ./.gitignore
    else
        deactivate &> /dev/null || rm -rf "$dir_for_rm/env/"
        rm -f "$dir_for_rm/.gitignore"
    fi
}
    
install(){
    local pm=""
    for manager in apt dnf yum pacman zypper apk; do
        if command -v "$manager" >/dev/null 2>&1; then
            pm="$manager"
            break
        fi
    done

    echo "Package manager is $pm"

    # Проверяем, есть ли sudo в системе. Если нет — выполняем команды напрямую.
    local cmd_prefix=""
    if command -v sudo &> /dev/null; then
        cmd_prefix="sudo"
    fi

    echo "Updating package lists..."
    $cmd_prefix apt update -y

    echo "Installing Python, development tools, and environment packages..."
    $cmd_prefix apt install -y \
        build-essential \
        git \
        gh \
        vim \
        nvim \
        docker.io \
        python3 \
        python3-pip \
        python3-venv \
        python3-dev \
        python3-build \
        python3-wheel \
        twine \
        python3-black \
        python3-flake8 \
        python3-mypy \
        python3-pytest \
        python3-coverage \
        python3-isort \
        python3-poetry \
        python3-jupyter \
        python3-django

    echo "All tools have been successfully installed!"
}
offline_install(){
    # Путь к папке со структурами (если скрипт лежит рядом с sources)
    local src_base="./sources"
    
    if [[ ! -d "$src_base" ]]; then
        echo "Error: Directory '$src_base' not found. Make sure you run this command from the correct path."
        return 1
    fi

    # Авто-определение sudo
    local cmd_prefix=""
    if command -v sudo &> /dev/null; then
        cmd_prefix="sudo"
    fi

    echo "===> Starting Offline Installation..."

    # 1. Установка базовых .deb пакетов из папки sources/deb/
    if [[ -d "$src_base/deb" ]]; then
        echo "Installing core .deb packages..."
        # Накатываем все deb'ы одной командой, чтобы dpkg слинковал их зависимости
        $cmd_prefix dpkg -i "$src_base"/deb/*.deb
    else
        echo "Warning: '$src_base/deb' directory not found, skipping core packages."
    fi

    # 2. Установка дополнительных инструментов через их локальные install.sh
    if [[ -d "$src_base/tar.gz" ]]; then
        echo "Installing advanced tools from tar.gz/ structures..."
        
        # Обходим каждую подпапку в sources/tar.gz/
        for dir in "$src_base/tar.gz"/*; do
            if [[ -d "$dir" ]]; then
                local tool_name
                tool_name=$(basename "$dir")
                
                if [[ -f "$dir/install.sh" ]]; then
                    echo "Running installer for: $tool_name"
                    (
                        cd "$dir" || exit 1
                        # Запускаем локальный install.sh с правами root/sudo
                        $cmd_prefix bash ./install.sh
                    )
                else
                    echo "Warning: No install.sh found for $tool_name"
                fi
            fi
        done
    else
        echo "Warning: '$src_base/tar.gz' directory not found."
    fi

    echo "===> Offline installation process completed!"
}
install_offline() {
    # Path to the package directory relative to the script location
    local pkg_dir="pip_sources/packages"

    # Check if the package directory exists
    if [ ! -d "$pkg_dir" ]; then
        echo "Error: Directory $pkg_dir not found!" >&2
        return 1
    fi

    # Check if there are any .whl files present
    if ! ls "$pkg_dir"/*.whl &>/dev/null; then
        echo "Error: No .whl files found in $pkg_dir!" >&2
        return 1
    fi

    # Configure flags for pip based on environment type
    local pip_flags=""
    if [ -z "$VIRTUAL_ENV" ]; then
        pip_flags="--break-system-packages"
        echo "Warning: Installing globally into the system environment..."
    fi

    echo "Starting offline installation of 100 packages from the local directory..."

    # Install all wheels from the specified directory completely offline
    pip install $pip_flags --no-index --find-links="$pkg_dir" "$pkg_dir"/*.whl

    if [ $? -eq 0 ]; then
        echo "Success! All 100 packages have been installed from the local source."
    else
        echo "Error: Failed to install some packages." >&2
        return 1
    fi
}

pip_install(){
    local pip_bin="./env/bin/pip"
    if [[ ! -f "$pip_bin" ]]; then
        echo "Error: Virtual environment (env/) not found in the current directory."
        echo "Please run 'pydk start_prj' first."
        return 1
    fi

    echo "Installing pip packages into local environment..."
    
    $pip_bin install \
