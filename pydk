run(){
    if [[ -d "./env" ]]; then
        if [[ -f "main.py" ]]; then
            ./env/bin/python3 main.py "$@"
        elif [[ -f "app.py" ]]; then
            ./env/bin/python3 app.py "$@"
        elif [[ -f "manage.py" ]]; then
            ./env/bin/python3 manage.py runserver "$@"
        else
            echo "Error: No main.py, app.py or manage.py found!"
        fi
    else
        echo "Error: Virtual environment (env/) not found in this directory."
    fi
}

clean(){
    echo "Cleaning up Python cache files..."
    find . -type d -name "__pycache__" -exec rm -rf {} +
    find . -type d -name ".pytest_cache" -exec rm -rf {} +
    find . -type d -name ".mypy_cache" -exec rm -rf {} +
    find . -type f -name "*.pyc" -delete
    rm -rf ./temp/
    echo "Done!"
}

build(){
    local target_dir="${1:-./}"
    local custom_name="$2"
    local main_file=""

    echo "Checking target directory: $target_dir"

    if [[ -f "$target_dir/main.py" ]]; then
        main_file="main.py"
    elif [[ -f "$target_dir/app.py" ]]; then
        main_file="app.py"
    else
        echo "Error: Cannot find main.py or app.py in '$target_dir' to build."
        return 1
    fi

    local py_bin="./env/bin/python3"
    if [[ -d "$target_dir/env" ]]; then
        py_bin="$target_dir/env/bin/python3"
    fi

    if ! $py_bin -m pip show pyinstaller &> /dev/null; then
        echo "PyInstaller not found. Installing it inside environment..."
        $py_bin -m pip install pyinstaller
    fi

    echo "Starting build process for $main_file..."
    local base_name="${main_file%.py}"

    (
        cd "$target_dir" || exit 1
        
        ./env/bin/pyinstaller --onefile "$main_file"
        
        echo "Cleaning up PyInstaller temporary files..."
        rm -rf "build/"
        rm -f "${base_name}.spec"
        
        if [[ -f ".gitignore" ]]; then
            if ! grep -q "^dist/" .gitignore; then
                echo "dist/" >> .gitignore
                echo "Added 'dist/' to .gitignore"
            fi
        fi

        local final_output="$base_name"
        if [[ -n "$custom_name" ]]; then
            if [[ -f "dist/$base_name" ]]; then
                mv "dist/$base_name" "dist/$custom_name"
                final_output="$custom_name"
                echo "Successfully renamed output to: dist/$custom_name"
            fi
        fi

        if [[ -f "dist/$final_output" ]]; then
            chmod +x "dist/$final_output"
            echo "Execution permissions successfully granted to: dist/$final_output"
        fi
    )
    echo "Build completed! Final executable located in '$target_dir/dist/'"
}
get_pm(){
    for pm in apt dnf yum pacman zypper apk; do
        if command -v "$pm" >/dev/null 2>&1; then
            echo -e "Package manager is $pm"
            break
        fi
    done
}
show_help(){
    echo "PyDK - Python Developer Kit"
    echo "Usage: pydk [command] [arguments]"
    echo ""
    echo "Commands:"
    echo "  start_prj     - Create a standard virtual environment (env/) in the target directory"
    echo "  start_git_prj - Create an environment, add .gitignore, and initialize Git"
    echo "  rem_prj       - Safely deactivate environment and remove env/ with .gitignore"
    echo "  run           - Automatically detect and run main.py, app.py, or Django server"
    echo "  clean         - Clear all __pycache__, pytest, mypy temporary cache files and temp/ directory"
    echo "  build         - Compile Python app into a standalone binary executable using PyInstaller"
    echo "  install       - Full automated system installation of Python dev stack via apt"
    echo "  pip_install   - Install a complete set of core dev, test, and GUI libraries into env/"
}

cmd="$1"

if [[ -z "$cmd" || "$cmd" == "help" || "$cmd" == "-h" || "$cmd" == "--help" ]]; then
    show_help
    exit 0
fi

if [[ "$(type -t "$cmd")" == "function" ]]; then
    "$@"
else
    show_help
    exit 1
fi
